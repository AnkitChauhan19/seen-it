# Application
APP_NAME=SeenIt
APP_ENV=development
DEBUG=true

# CORS — comma-separated origins (use * only for local development)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Supabase (configure after creating a project)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# TMDB (never expose these in the mobile app)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
# Optional tuning
# TMDB_MAX_REQUESTS_PER_SECOND=8
# TMDB_SEARCH_CACHE_TTL_SECONDS=120
# TMDB_DISCOVER_CACHE_TTL_SECONDS=600
